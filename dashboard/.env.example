# ── Источник данных ────────────────────────────────────────────────────────────
# db   — прямое подключение к PostgreSQL (только чтение)
# api  — тянем через уже готовый эндпоинт бота /api/dashboard/all
# demo — локальные тестовые данные из demo_data.json, БД не трогается вообще
SOURCE_MODE=db

# Для SOURCE_MODE=db. Строку возьми в панели Relax Dev у той же базы, что у бота.
# ВАЖНО: сервис открывает сессию с default_transaction_read_only=on — записать он не может.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Для SOURCE_MODE=api
BOT_API_URL=https://your-bot-host
BOT_API_KEY=

# ── Приложение ─────────────────────────────────────────────────────────────────
PORT=8090
TIMEZONE=Europe/Moscow
# Как часто сервис реально ходит в базу (секунды). Браузеры бьют в кеш, не в БД.
CACHE_TTL=60
# Как часто страница сама себя перерисовывает (секунды).
REFRESH_SECONDS=60
# Глубина выборки в днях — защита от чтения всей истории разом.
MAX_DAYS=400
# Даты, которые дашборд не показывает (через запятую, формат YYYY-MM-DD).
# База НЕ меняется — записи остаются на месте, просто не попадают в отчёт.
# Убери дату из списка, и она снова появится на дашборде.
EXCLUDE_DATES=2026-09-01
# Жёсткий таймаут SQL-запроса в миллисекундах.
STATEMENT_TIMEOUT_MS=15000
LOG_LEVEL=INFO
